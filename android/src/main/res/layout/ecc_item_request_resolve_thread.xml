<?xml version="1.0" encoding="utf-8"?>
<kg.bakai.capacitor.edna.BankResolveRequestLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp" android:layout_marginVertical="16dp"
    android:padding="20dp" android:orientation="vertical" android:gravity="center_horizontal">
    <View android:id="@+id/top_separator" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <edna.chatcenter.ui.visual.widget.textView.BubbleMessageTextView
        android:id="@+id/request_to_resolve_thread" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingTop="2dp" android:includeFontPadding="false" />
    <TextView android:id="@+id/bakai_resolve_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:text="Продолжить консультацию?" android:includeFontPadding="false" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="28dp" android:orientation="horizontal">
        <edna.chatcenter.ui.visual.widget.textView.BubbleMessageTextView
            android:id="@+id/deny_request" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:lines="1" android:includeFontPadding="false" />
        <edna.chatcenter.ui.visual.widget.textView.BubbleMessageTextView
            android:id="@+id/approve_request" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:lines="1" android:includeFontPadding="false" />
    </LinearLayout>
    <View android:id="@+id/bottom_separator" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</kg.bakai.capacitor.edna.BankResolveRequestLayout>
