<?xml version="1.0" encoding="utf-8"?>
<!-- Based on Edna 5.23.0: retain all SDK binding IDs/types when updating. -->
<edna.chatcenter.ui.visual.views.InterceptTouchFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/restoring_state_view" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/bakaiEdnaPage">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/ecc_restoring_state" android:textColor="?attr/bakaiEdnaText" />
    </FrameLayout>
    <RelativeLayout android:id="@+id/chat_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ecc_chat_background">
        <FrameLayout android:id="@+id/chat_content" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/bottom_layout" android:layout_alignParentStart="true" android:paddingTop="64dp">
            <edna.chatcenter.ui.visual.views.EdnaSwipeRefreshLayout android:id="@+id/swipe_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/chatItemsRecycler" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="4dp" android:paddingBottom="4dp" />
            </edna.chatcenter.ui.visual.views.EdnaSwipeRefreshLayout>
            <edna.chatcenter.ui.visual.views.WelcomeScreen android:id="@+id/welcome" android:layout_width="match_parent" android:layout_height="match_parent" />
            <edna.chatcenter.ui.visual.views.search.SearchListView android:id="@+id/searchListView" android:layout_width="match_parent" android:layout_height="match_parent" tools:visibility="gone" />
            <include android:id="@+id/chatErrorLayout" layout="@layout/ecc_chat_error_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" />
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/scroll_down_button_container" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_above="@+id/bottom_layout" android:layout_alignParentRight="true" android:layout_margin="@dimen/ecc_scroll_down_button_margin" android:visibility="gone" tools:visibility="visible">
            <ImageView android:id="@+id/scroll_down_button" android:layout_width="@dimen/ecc_scroll_down_button_width" android:layout_height="@dimen/ecc_scroll_down_button_height" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:background="@drawable/ecc_scroll_down_background" android:elevation="@dimen/ecc_scroll_down_button_elevation" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:srcCompat="@drawable/ecc_scroll_down_icon" />
            <View android:id="@+id/unread_msg_sticker" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/ecc_circle_red" android:elevation="@dimen/ecc_scroll_down_button_elevation" android:visibility="invisible" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
            <edna.chatcenter.ui.visual.widget.CustomFontTextView android:id="@+id/unread_msg_count" android:layout_width="20dp" android:layout_height="20dp" android:elevation="@dimen/ecc_scroll_down_button_elevation" android:gravity="center" android:visibility="invisible" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@+id/unread_msg_sticker" tools:text="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/scroll_up_button_container" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_below="@id/toolbar" android:layout_alignParentEnd="true" android:layout_marginTop="@dimen/ecc_scroll_up_button_top_margin" android:layout_marginEnd="@dimen/ecc_scroll_up_button_right_margin" android:visibility="gone" tools:visibility="visible">
            <ImageView android:id="@+id/scroll_up_button" android:layout_width="@dimen/ecc_scroll_up_button_width" android:layout_height="@dimen/ecc_scroll_down_button_height" android:layout_marginStart="4dp" android:layout_marginTop="8dp" android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:background="@drawable/ecc_scroll_down_background" android:elevation="@dimen/ecc_scroll_down_button_elevation" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:srcCompat="@drawable/ecc_scroll_up_icon" />
            <View android:id="@+id/unread_msg_up_button_sticker" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/ecc_circle_red" android:elevation="@dimen/ecc_scroll_down_button_elevation" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <edna.chatcenter.ui.visual.widget.CustomFontTextView android:id="@+id/unread_msg_up_button_count" android:layout_width="20dp" android:layout_height="20dp" android:elevation="@dimen/ecc_scroll_down_button_elevation" android:gravity="center" android:textColor="@color/ecc_chat_unread_msg_count_text" android:textSize="@dimen/ecc_text_small" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@+id/unread_msg_up_button_sticker" tools:text="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout android:id="@+id/bottom_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:background="@drawable/bakai_edna_footer_fade" android:orientation="vertical" android:visibility="invisible">
                <LinearLayout android:id="@+id/copy_controls" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_horizontal" android:orientation="horizontal" android:visibility="gone">
                    <ImageButton android:id="@+id/reply" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:contentDescription="Ответить" android:background="@null" android:tag="replyIcon" />
                    <ImageButton android:id="@+id/content_copy" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="@dimen/ecc_margin_big" android:background="@null" android:padding="12dp" android:contentDescription="Копировать" />
                </LinearLayout>
            <LinearLayout android:id="@+id/quote_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:visibility="gone" tools:visibility="visible" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageButton android:id="@+id/quote_past" android:layout_width="24dp" android:layout_height="match_parent" android:layout_marginStart="@dimen/ecc_activity_horizontal_margin" android:background="@null" tools:visibility="gone" />
                <ImageView android:id="@+id/quote_image" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_vertical" android:minWidth="1dp" android:padding="@dimen/ecc_margin_half" android:visibility="gone" />
                <ImageView android:id="@+id/quote_button_play_pause" android:layout_width="64dp" android:layout_height="match_parent" android:background="@null" android:scaleType="centerInside" android:visibility="gone" tools:visibility="visible" />
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="@dimen/ecc_activity_horizontal_margin" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <com.google.android.material.slider.Slider android:id="@+id/quote_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:theme="@style/ThemeOverlay.ChatCenter.Slider.Preview" android:visibility="gone" />
                    <edna.chatcenter.ui.visual.widget.textView.QuoteHeaderTextView android:id="@+id/quote_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="4dp" android:ellipsize="end" android:lines="1" tools:text="title_title_title" />
                    <edna.chatcenter.ui.visual.widget.textView.QuoteMessageTextView android:id="@+id/quote_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:ellipsize="end" android:lines="1" tools:text="text_text_text_text_text_text_text_text_text_text_text_text_text_text_text_text" />
                </LinearLayout>
                <TextView android:id="@+id/quote_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" tools:text="00:00" />
                <ImageButton android:id="@+id/quote_clear" android:layout_width="44dp" android:layout_height="match_parent" android:background="@null" app:srcCompat="@drawable/ecc_ic_clear_36dp" android:padding="12dp" />
            </LinearLayout>
            <View android:id="@+id/delimeter" android:layout_width="match_parent" android:layout_height="1dp" android:background="#e5e5e5" android:visibility="gone" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/input_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" android:baselineAligned="false" android:orientation="horizontal" android:gravity="bottom" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="bottom" android:orientation="horizontal" android:minHeight="44dp" android:background="@drawable/bakai_edna_pill">
                        <edna.chatcenter.ui.visual.widget.CustomFontEditText android:id="@+id/input_edit_view" style="@style/InputEditTextStyle" android:ellipsize="end" android:hint="@string/bakai_edna_input_placeholder" android:inputType="textCapSentences|textMultiLine" android:maxLines="7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="44dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="4dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textSize="@dimen/bakai_edna_input_text_size" android:background="@android:color/transparent" android:includeFontPadding="false" />
                        <ImageButton android:id="@+id/add_attachment" style="@style/Base.Widget.AppCompat.Button.Borderless" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:tag="add_attachment" android:padding="11dp" android:scaleType="centerInside" />
                    </LinearLayout>
                    <ImageButton android:id="@+id/send_message" style="@style/Base.Widget.AppCompat.Button.Borderless" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bakai_edna_round_button" android:layout_marginStart="6dp" android:padding="11dp" android:scaleType="centerInside" />
                </LinearLayout>
                <LinearLayout android:id="@+id/recordLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="0dp" android:baselineAligned="false" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="bottom">
                    <edna.chatcenter.ui.visual.views.recordview.VoiceRecordView android:id="@+id/record_view" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/ecc_input_background" android:visibility="invisible" app:counter_time_color="#ff0000" app:slide_to_cancel_arrow="@drawable/recv_ic_arrow" app:slide_to_cancel_arrow_color="#000000" app:slide_to_cancel_bounds="10dp" app:slide_to_cancel_margin_right="10dp" app:slide_to_cancel_text="Slide To Cancel" />
                    <edna.chatcenter.ui.visual.views.recordview.VoiceRecordButton android:id="@+id/record_button" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bakai_edna_round_button" android:scaleType="centerInside" android:padding="11dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <View android:id="@+id/toolbar_shadow" android:layout_width="match_parent" android:layout_height="76dp" android:background="@drawable/bakai_edna_header_fade" />
        <View android:id="@+id/statusBarBackground" android:layout_width="match_parent" android:layout_height="0dp" />
        <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="64dp" android:background="@android:color/transparent" app:contentInsetStart="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:elevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/chat_back_button" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:visibility="gone" tools:visibility="visible" android:padding="10dp" android:background="@drawable/bakai_edna_round_button" android:scaleType="centerInside" />

                <LinearLayout android:id="@+id/bakai_edna_profile" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="14dp" android:background="@drawable/bakai_edna_pill">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/bakai_edna_support" android:background="@drawable/bakai_edna_pill" android:importantForAccessibility="no" android:tint="?attr/bakaiEdnaText" />
                    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp">
                    <LinearLayout android:id="@+id/consult_title" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center_vertical" android:layout_marginStart="0dp" android:layout_marginTop="0dp" android:layout_marginEnd="0dp" android:layout_marginBottom="0dp" android:gravity="center_vertical" android:orientation="vertical">
                        <edna.chatcenter.ui.visual.widget.textView.ToolbarTitleTextView android:id="@+id/consult_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center_vertical" android:lines="1" tools:text="@string/ecc_chat_title_waiting_for_specialist" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" />
                        <edna.chatcenter.ui.visual.widget.textView.ToolbarSubtitleTextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:visibility="gone" android:textSize="11sp" android:includeFontPadding="false" android:layout_marginTop="2dp" />
                        <edna.chatcenter.ui.visual.views.search.SearchBarView android:id="@+id/searchBar" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
                    </LinearLayout>
                        <kg.bakai.capacitor.edna.BankLoadingDots android:layout_width="13dp" android:layout_height="12dp" android:layout_gravity="start|center_vertical" android:visibility="invisible" android:contentDescription="@string/bakai_edna_loading" />
                    </FrameLayout>
                </LinearLayout>
                <ImageButton android:id="@+id/search_menu_button" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:padding="10dp" android:background="@drawable/bakai_edna_round_button" android:scaleType="centerInside" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
        <LinearLayout android:id="@+id/fl_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@+id/toolbar" android:layout_alignParentStart="true" android:background="@color/ecc_empty_state_background" android:gravity="center" android:orientation="vertical" android:visibility="gone" tools:visibility="visible">
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/progress_bar" android:alpha="0" android:importantForAccessibility="no" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" />
            <androidx.appcompat.widget.AppCompatTextView android:id="@+id/tv_empty_state_hint" android:alpha="0" android:importantForAccessibility="no" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ecc_empty_chat_placeholder_subtitle" android:textColor="?attr/bakaiEdnaText" />
        </LinearLayout>
    </RelativeLayout>
</edna.chatcenter.ui.visual.views.InterceptTouchFrameLayout>
