<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout" android:minHeight="42dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <kg.bakai.capacitor.edna.BankAvatarSourceView
        android:id="@+id/consultAvatar"
        android:scaleType="fitCenter"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignBottom="@id/bubble"
        android:layout_marginStart="@dimen/bakai_edna_message_side_margin" />

    <edna.chatcenter.ui.visual.widget.textView.BubbleTimeTextView
        android:id="@+id/errorText"
        style="@style/timestamp"
        android:layout_below="@+id/bubble"
        android:layout_marginStart="@dimen/ecc_consultant_margin_right"
        android:layout_marginTop="@dimen/ecc_margin_material"
        android:textSize="@dimen/ecc_error_text_size"
        android:visibility="gone"
        tools:text="Some error text"
        tools:visibility="visible" />

    <kg.bakai.capacitor.edna.BankMessageBubble
        android:id="@+id/bubble"
        style="@style/consultBubble"
        android:layout_toEndOf="@+id/bank_client_side"
        android:orientation="vertical">

        <edna.chatcenter.ui.visual.views.QuoteHolderView
            android:id="@+id/quoteView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ecc_margin_quarter"
            android:paddingTop="@dimen/ecc_margin_half" />

        <kg.bakai.capacitor.edna.BankImagePreview
            android:id="@+id/imageRoot"
            android:layout_width="@dimen/ecc_message_image_size"
            android:layout_height="@dimen/ecc_message_image_size">

            <FrameLayout
                android:id="@+id/imageLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/loaderImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="75dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true" />

            </FrameLayout>

            <ImageView
                android:id="@+id/errorImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:minWidth="200dp"
                android:minHeight="200dp"
                android:visibility="gone" />

        </kg.bakai.capacitor.edna.BankImagePreview>

        <include
            layout="@layout/ecc_consult_file_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="@dimen/ecc_margin_quarter"
            android:paddingTop="@dimen/ecc_margin_half" />

        <FrameLayout
            android:id="@+id/phraseFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="0dp">

            <edna.chatcenter.ui.visual.widget.textView.BubbleMessageTextView
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:autoLink="none"
                android:lineSpacingMultiplier="1" android:includeFontPadding="false" android:textStyle="normal"
                android:paddingTop="0dp"
                android:tag="textMessage"
                app:last_line_extra_padding_symbols="0"
                tools:text="text text text text google.com" />

            <edna.chatcenter.ui.visual.widget.textView.BubbleTimeTextView
                android:id="@+id/timeStamp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="bottom|end"
                android:drawablePadding="0dp"
                android:textColor="@color/ecc_operator_message_timestamp"
                tools:text="10:19" android:maxWidth="0dp" android:alpha="0" />

        </FrameLayout>

        <include layout="@layout/ecc_open_graph_layout" />

    </kg.bakai.capacitor.edna.BankMessageBubble>

    <edna.chatcenter.ui.visual.widget.textView.BubbleTimeTextView
        android:id="@+id/imageTimeStamp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignEnd="@id/bubble"
        android:layout_alignBottom="@id/bubble"
        android:layout_marginEnd="@dimen/ecc_imageTimeLabelMarginRight"
        android:layout_marginBottom="@dimen/ecc_imageTimeLabelMarginBottom"
        android:background="@drawable/ecc_timestamp_incoming_underlayer"
        android:drawablePadding="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        tools:text="10:19" android:maxWidth="0dp" android:alpha="0" />

    <kg.bakai.capacitor.edna.BankClientSideView android:id="@+id/bank_client_side" android:tag="incoming" android:layout_width="30dp" android:layout_height="42dp" android:layout_marginStart="8dp" android:layout_alignParentStart="true" android:layout_alignParentTop="true" />
</RelativeLayout>