<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/activity_root"
    android:forceDarkAllowed="false"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".visual.activities.ImagesActivity">

    <FrameLayout
        android:id="@+id/imageFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar" />

    <View
        android:id="@+id/toolbar_shadow"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="@drawable/ecc_toolbar_shadow" />

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/ecc_attachments_toolbar_background"
        app:titleTextColor="@color/ecc_attachments_toolbar_text"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ecc_toolbar_height"
        android:layout_below="@id/statusBarBackground"
        app:contentInsetStart="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <kg.bakai.capacitor.edna.BankMediaBackButton
                android:id="@+id/back_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:translationZ="0dp"
                android:stateListAnimator="@null"
                android:outlineProvider="none"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerInside"
                android:background="@drawable/bakai_edna_media_button_light"
                android:padding="11dp" />

            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"/>

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>
</RelativeLayout>